# propOS Backend Environment Configuration
PROJECT_NAME="propOS Engine API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY="propos_super_secret_jwt_key_change_in_production_min_32_bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days
ALGORITHM="HS256"

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="propos_db"
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/propos_db"

# CORS Configuration (Allowed origins comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://*.azurestaticapps.net"

# External Integrations (Optional / Staging)
OPENAI_API_KEY="sk-..."
ELEVENLABS_API_KEY="..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
