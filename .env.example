# Azure Environment Variables for PropSales AI FastAPI Backend

# 1. Database Connection (Azure Database for PostgreSQL Flexible Server or Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePassword@your-azure-postgres.postgres.database.azure.com:5432/propos_db

# 2. Application Security
SECRET_KEY=your_super_secret_jwt_key_min_32_characters_long_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. CORS Allowed Origins (Comma-separated list of allowed frontend domains)
ALLOWED_ORIGINS=https://your-app.azurestaticapps.net,http://localhost:3000

# 4. Port Configuration (Required for Azure App Service & Container Instances)
PORT=8000
WEBSITES_PORT=8000

# 5. Project Metadata
PROJECT_NAME=propOS Engine API
VERSION=1.0.0
API_V1_STR=/api/v1
